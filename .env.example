# Radgotchi Skill Environment Variables
# Rename this to .env and fill in your values.
# These are loaded automatically — no system env vars needed.

# Grafana
# GRAFANA_URL=http://grafana.local:3000
# GRAFANA_API_KEY=your-grafana-service-account-token

# Home Assistant
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=your-long-lived-access-token
